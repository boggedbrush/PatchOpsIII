{
  "name": "patchopsiii",
  "version": "1.3.0-beta4",
  "description": "Tauri control center for Call of Duty: Black Ops III maintenance, mod setup, and performance tuning.",
  "author": "boggedbrush",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "start": "tauri dev",
    "build": "bun run build:renderer",
    "build:renderer": "bun run typecheck && vite build",
    "dist": "tauri build",
    "dist:linux": "tauri build --bundles appimage",
    "dist:win": "tauri build --bundles msi",
    "test": "bun run test:renderer && bun run test:rust",
    "test:renderer": "bun test src/renderer",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run test && bun run verify:release",
    "verify:release": "node scripts/verify-release-metadata.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@types/bun": "^1.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.0",
    "typescript": "^5.6.0"
  }
}
